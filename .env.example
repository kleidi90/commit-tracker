# Optional. Copy to .env to change anything; docker compose reads .env automatically.
# Everything has a working default, so `docker compose up` also runs without this file.

# Without a token GitHub allows 60 API requests per hour, with one 5000.
# A fine-grained token with read-only access to public repositories is enough.
GITHUB_TOKEN=

WEB_PORT=8080
DB_PORT=5433
POSTGRES_PASSWORD=app
