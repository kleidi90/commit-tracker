# Committed defaults for local development. Real environment variables
# (for example from docker-compose.yml) take precedence over this file.
# Put machine-specific overrides in .env.local, which is not committed.

APP_ENV=dev
APP_SECRET=dev_only_change_me

DATABASE_URL="postgresql://app:app@db:5432/app?serverVersion=16&charset=utf8"

MESSENGER_TRANSPORT_DSN=doctrine://default

# Optional. Without a token GitHub allows 60 requests per hour, with one 5000.
GITHUB_TOKEN=
